 INIT_VAR 0x4168
 SETVAR MP3_CHIP_TYPE,		BYTE

UKLAD1						;’“„€ „ € ƒ‘ ‡€„›‚€’
		PHASE SETUPSD
;‘€ “‘’€‚™ „€‰‚…€ „‹ NeoGS
		DI
		LD A,0X9C
		OUT (SCTRL),A			;”ƒ“€’ NeoGS
		CALL AVTODET
		AND A
		LD A,0X77			;0X77-NeoGS €‰„…
		JR Z,$+4
		LD A,0XCC			;0XCC-€‰„… OLDGS
		OUT (ZXDATWR),A
