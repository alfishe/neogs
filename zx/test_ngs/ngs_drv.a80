;‚…€ —’ ’ NeoGS  ‚‹—…… —€‘’’› 24MHz
AVTODET		IN A,(GSCFG0)
		AND 0XCF
		OUT (GSCFG0),A			;€’€ ‡€‘ ‚ ’ ‘ ‘…›
						;’€ 5-4 ‚‹—€…’ —€‘’’“ –…‘‘€ €‚› 24 ƒζ
		LD D,A
		IN A,(GSCFG0)
		CP D
		LD A,0
		RET Z
		DEC A
		RET
UKLAD2						;’“„€ „ ……„›‚€’
		DEPHASE

		PHASE 0X1D00
;™€ ’—€ ‚•„€ „‹ €’› ‘
GSDDRV		DI
		IN A,(ZXDATRD)			;… €„› „€‰‚…€
		OUT (CLRCBIT),A			;‘‘ COMANDBIT
		LD HL,COMINT_
		PUSH HL
		ADD A,A
		LD E,A
		LD D,0
		LD HL,TABLSDG
		ADD HL,DE
		LD E,(HL)
		INC HL
		LD D,(HL)
		EX DE,HL
		CALL WDY
		IN A,(ZXDATRD)			;… ’‚ 31-24 €€…’€
		LD B,A
		CALL WDY
		IN A,(ZXDATRD)			;… ’‚ 23-16 €€…’€
		LD C,A
		CALL WDY
		IN A,(ZXDATRD)			;… ’‚ 15-8 €€…’€
		LD D,A
		CALL WDY
		IN A,(ZXDATRD)			;… ’‚ 7-0 €€…’€
		LD E,A
		CALL WDY
		IN A,(ZXDATRD)			;… ‹-‚ ‘…’‚
		JP (HL)

TABLSDG		DW SDINITG			; 00 €€…’‚ … ’…“…’, € ‚›•„… A
						;    ‘’ ‚›… …‚›… 2 ‡€—…
		DW SDOFFG			; 01 ‘’ ‘’… ‚›€ SD €’›
		DW RDSING			; 02 —’€’ 1 ‘…’
		DW RDMULG			; 03 —’€’ "A" ‘…’‚
		DW OK_WORK;WRSING			; 04 ‘€’ 1 ‘…’
		DW OK_WORK;WRMULG			; 05 ‘€’ "A" ‘…’‚
		DW GET_CHIPTYPE			; 06
