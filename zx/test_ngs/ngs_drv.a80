GET_CHIPTYPE	CALL HARDMP3
.L1		IN A,(ZXSTAT)
		RRA
		JR NC,.L1
		OUT (CLRCBIT),A
		LD A,(MP3_CHIP_TYPE)
		OUT (ZXDATWR),A
		CALL WDN
		JP OK_WORK

SET_FREQ	CALL FREQNC
		JP OK_WORK

FREQNC		LD A,E
		LD D,C_10MHZ			; 0x30
		AND 3
		JR Z,.L1
		LD D,C_12MHZ			; 0x10
		DEC A
		JR Z,.L1
		LD D,C_20MHZ			; 0x20
		DEC A
		JR Z,.L1
		LD D,C_24MHZ			; 0
.L1		IN A,(GSCFG0)
		AND %11001111
		OR D
		OUT (GSCFG0),A
		RET

; ―®«­λ© α΅ΰ®α
HARDMP3
;		CALL VOL_MOD			; § £«γθ¨«¨ £ΰ®¬ª®αβμ ―®ΰβ®Ά GS
		LD BC,MC_SEND
		LD A,%10011100			; 0x9C
		OUT (SCTRL),A
		LD E,0
		CALL FREQNC			; Άλαβ Ά¨«¨ η αβ®βγ ­  NGS 10 ƒζ
		LD HL,VS10XX_READ << 8 + SCI_STATUS;0x0301
		CALL COM_MP3
		LD A,M_MPXRS
		OUT (SCTRL),A
		CALL NOPER
		LD A,M_MPXRS + M_SNCLR		; 0x84
		OUT (SCTRL),A			; Άλ¤ «¨ α΅ΰ®α ­  ¤¥ª®¤¥ΰ
;		CALL DRQVS
		CALL SET_CLOCKF
		CALL RTYPEVS
		LD A,(MP3_CHIP_TYPE)
		PUSH AF
		CP VS1001
		LD HL,VS10XX_WRITE << 8 + SCI_BASS; 0x0202
		LD DE,%1000000000001000		; 0x8008
		CALL Z,COM_MP3			; ¤«ο VS1001 § ―¨αμ ­¥¤®ªγ¬¥­β¨ΰ®Ά ­­®£® ―¨­ª  Ά
						; ­¥¤®ªγ¬¥­β¨ΰ®Ά ­­λ© ΰ¥£¨αβΰ, ¥α«¨
						; ΅¨βλ 7-4 ΰ¥£¨αβΰ  αβ βγα  Ά ­γ«¥
		LD HL,VS10XX_WRITE << 8 + SCI_MODE
		LD DE,0
		CALL COM_MP3
		POP AF
		CP VS1001
		JR Z,.L1
		LD HL,VS10XX_WRITE << 8 + SCI_AIADDR
		LD DE,0
		CALL COM_MP3
.L1		LD E,0
		JP FREQNC			; Άλαβ Ά¨«¨ η αβ®βγ ­  NGS 10 ƒζ

; ®―ΰ¥¤¥«¥­¨¥ γαβ ­®Ά«¥­­®£® η¨― 
RTYPEVS		LD HL,VS10XX_READ << 8 + SCI_STATUS
		CALL COM_MP3
		LD A,E					; ­ α ¨­β¥ΰ¥αγξβ ΅¨βλ 7-4 ¨§ ΰ¥£¨αβΰ  αβ βγα 
		AND SCISTATUS.M_SS_VER
		RRCA
		RRCA
		RRCA
		RRCA
		LD (MP3_CHIP_TYPE),A			; β¨― γαβ ­®Ά«¥­­®£® MP3 η¨― 
		RET

; SS_VER Ά ΅¨β ε 7-4
TABL_CLOCK	DW 0x8000 + (14000000 / 2000)	; 0 for VS1001	(MA8201)	9B58
		DW 0x8000 + (14000000 / 2000)	; 1 for VS1011	(MA8201A)	9B58
		DW 0	; 2 for VS1002	; ­¥ ―®¤¤¥ΰ¦¨Ά ¥βαο, ­¥ ―ΰ®Ά¥ΰο«αο
		DW SC_MULT4 | SC_ADD3 | 1500	; 3 for VS1003
		DW SC_MULT4 | SC_ADD1 | 1500	; 4 for VS1053 and VS8053	; ―®ª  ­¥ ¤®¤¥« ­
		DW 0	; 5 for VS1033	; ­¥ ―®¤¤¥ΰ¦¨Ά ¥βαο, ­¥ ―ΰ®Ά¥ΰο«αο
		DW SC_MULT4 | SC_ADD1 | 1500	; 6 for VS1063	; ―®ª  ­¥ ¤®¤¥« ­
		DW 0	; 7 for VS1103	; ­¥ ―®¤¤¥ΰ¦¨Ά ¥βαο, ­¥ ―ΰ®Ά¥ΰο«αο

; γαβ ­®Άª  η αβ®βλ MP3 η¨― 
SET_CLOCKF	LD A,(MP3_CHIP_TYPE)
		ADD A,A
		ADD A,LOW (TABL_CLOCK)
		LD L,A
		ADC A,HIGH (TABL_CLOCK)
		SUB L
		LD H,A
		LD E,(HL)
		INC HL
		LD D,(HL)
		LD HL,VS10XX_WRITE << 8 + SCI_CLOCKF;0x0202
		CALL COM_MP3			; γαβ ­®Άª  η αβ®βλ ¤«ο ¤¥ª®¤¥ΰ 

; ®¦¨¤ ­¨¥ £®β®Ά­®αβ¨ MP3 ¤¥ª®¤¥ΰ 
DRQVS		IN A,(SSTAT)
		RRA				; B_MDDRQ
		JR NC,DRQVS			; ¤®¦¤ «¨αμ £®β®Ά­®αβ¨ ¤¥ª®¤¥ΰ 
		RET

; ―ΰ®ζ¥¤γΰ  ηβ¥­¨ο/§ ―¨α¨  ¤ΰ¥α®Ά MP3 ¤¥ª®¤¥ΰ 
; H - ª®¬ ­¤  ¤¥ª®¤¥ΰγ 3-READ ¨«¨ 2-WRITE
; L -  ¤ΰ¥α Ά ¤¥ª®¤¥ΰ¥
; D - αβ ΰθ¨© ΅ ©β
; E - ¬« ¤θ¨© ΅ ©β
; DE ―® § ―¨α¨ ―®¤ βμ ­  Άε®¤
;    ―® ηβ¥­¨ξ ―®«γη¨βμ ­  Άλε®¤¥
COM_MP3		CALL DRQVS
		LD A,M_MCNCS
		OUT (SCTRL),A			; Άλ΅¨ΰ ¥¬ ¤¥ª®¤¥ΰ ¨ ®΅κοα­ο¥¬ ¥¬γ, ηβ® ®β ­¥£® βΰ¥΅γ¥βαο
		CALL NOPER
		LD BC,MC_SEND
		LD A,H
		OUT (C),H
		CALL NOPER
		OUT (C),L
		CALL NOPER
		CP VS10XX_READ
		JR Z,MP3READ			; ―¥ΰ¥ε®¤¨¬ ­  ηβ¥­¨¥ (α¬®βΰ¨ Άλθ¥)
		OUT (C),D
		CALL NOPER
		OUT (C),E			; § ―¨α «¨ Ά  ¤ΰ¥α ¤¥ª®¤¥ΰ 
MP3_END
;		CALL NOPER
		CALL DRQVS
		LD A,M_MCNCS + M_SNCLR		; 0x82 α­¨¬ ¥¬ Άλ΅®ΰ ¤¥ª®¤¥ΰ 
		OUT (SCTRL),A
