
; LAST UPDATE: 26.10.2025 savelij
	
		include macros.a80

ADRWORK		EQU ADR_START
UNPACKER	EQU 0x5B00

		ORG ADRWORK-0x11
	SUM_HOB "testngs C",ADRWORK,EBINFLASHER-START,SIZE_SECTORS

START		DI
		JR START0

		DB "Test NeoGS build "
		TEXTDATE
		DB 0

START0		LD HL,ADRWORK
		PUSH HL
		LD HL,DEPACK
		LD DE,UNPACKER
		LD BC,BINFLASHER-DEPACK
		PUSH DE
		LDIR
		LD HL,EBINFLASHER-1
		LD DE,0xFFFF
		LD BC,EBINFLASHER-BINFLASHER
		LDDR
		LD HL,ADRWORK
		EX DE,HL
		INC HL
		RET

DEPACK		include dec40.a80
BINFLASHER	binclude tmp/testngs.pack
EBINFLASHER

		DB LOW (-$) DUP 0

		IF (EBINFLASHER-BINFLASHER)&0xFF
SIZE_SECTORS	EQU ((EBINFLASHER-BINFLASHER)>>8)+1
		ELSE
SIZE_SECTORS	EQU ((EBINFLASHER-BINFLASHER)>>8)
		ENDIF
