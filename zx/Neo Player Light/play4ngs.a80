		LD (GETVTSH),A

CP_XB		LD A,(GETVTSH)
		BIT 7,A
		JR Z,XB1
		LD DE,(VSTBL)
XB2		LD HL,0X0202
		JR XB3

XB1		LD HL,0X0302
		LD A,Com_mp3
		CALL COM__SD
		LD (VSTBL),DE
		LD DE,0
		JR XB2

;----FUNC0B----
;Ž‹“—ˆ’œ ‚…ŒŸ Žˆƒ›‚€ˆŸ
GETTIME		LD HL,0X0304
		LD A,Com_mp3
		CALL COM__SD
		EX DE,HL
		LD DE,BUFTIME
		PUSH DE
		LD BC,36000
		CALL SUB_BC
		LD BC,3600
		CALL SUB_BC
		LD BC,600
		CALL SUB_BC
		LD BC,60
		CALL SUB_BC
		LD BC,10
		CALL SUB_BC
