
; LAST UPDATE: 13.01.2024 savelij
	
		include macros.a80
		include ../vers.a80

ADRWORK		EQU ADR_START
UNPACKER	EQU 0x5B00

		ORG ADRWORK-0x11
		SUM_HOB "npl     C",ADRWORK,EBINFLASHER-BINFLASHER,SIZE_SECTORS

		DI
		JR START0

		DB "Neo Player Light ",VERS_PLAYER

START0		LD HL,ADRWORK
		PUSH HL
		LD HL,DEPACK
		LD DE,UNPACKER
		LD BC,BINFLASHER-DEPACK
		PUSH DE
		LDIR
		LD HL,EBINFLASHER-1
		LD DE,0xFFFF
		LD BC,EBINFLASHER-BINFLASHER
		LDDR
		LD HL,ADRWORK
		EX DE,HL
		INC HL
		RET

DEPACK		include dec40.a80
BINFLASHER	binclude ../tmp/npl.pack
EBINFLASHER

		DUPL 0x100-LOW ($),0

		IF (EBINFLASHER-BINFLASHER)&0xFF
SIZE_SECTORS	EQU ((EBINFLASHER-BINFLASHER)>>8)+1
		ELSE
SIZE_SECTORS	EQU ((EBINFLASHER-BINFLASHER)>>8)
		ENDIF
