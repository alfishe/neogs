
; LAST UPDATE: 19.04.2023 savelij

WITH_BUILD	EQU	1	; BIOS NUMBER INCLUDED BUILD NUMBER
WITH_2IDE	EQU	1	; SECONDARY IDE

IPOINT		EQU 0X0018

RAM_ATAPI_PK 	EQU 0xFEE0
RAM_ATAPI_READ	EQU 0xFEF0

SIZESEC		EQU 0x0800
PKTSIZE		EQU 12

RAMD_KEY_NUM	EQU 16

CL0		EQU 200
CL1		EQU 240

Version		EQU 0x020D	; Version BIOS
RESTARTS	EQU 0FFE0H

D_TBON		EQU 3	; данные для включения TURBO
D_TBOFF		EQU 2	; данные для включения TURBO
D_ROM16ON	EQU 1
D_ROM16OFF	EQU 0

ALTERA		EQU 1400H

; цвета поллитры BIOS
 INIT_VAR
 SETVAR BLACK
 SETVAR BLUE
 SETVAR GREEN
 SETVAR CYAN
 SETVAR RED
 SETVAR MAGENTA
 SETVAR BROWN
 SETVAR LGRAY
 SETVAR DGRAY
 SETVAR LBLUE
 SETVAR LGREEN
 SETVAR LCYAN
 SETVAR LRED
 SETVAR LMAGENT
 SETVAR YELLOW
 SETVAR WHITE
