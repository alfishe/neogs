
; LAST UPDATE: 19.04.2023 savelij

; RGC - номер функции BIOS
; RGB - регистр B
; RGA - регистр A
SPBIOS		MACRO RGC,RGB,RGA,RGIX
	IFNB RGIX
		LD IX,RGIX
	ENDIF

	IFNB RGA
	IF RGA = 0
		XOR A
	ELSE
		LD A,RGA
	ENDIF
	ENDIF

	IFNB RGB
		LD BC,RGB << 8 + RGC
	ELSE
		LD C,RGC
	ENDIF
		RST 8
		ENDM

SPDSS		MACRO RGC,RGB,RGA,RGIX
	IFNB RGIX
		LD IX,RGIX
	ENDIF

	IFNB RGA
	IF RGA = 0
		XOR A
	ELSE
		LD A,RGA
	ENDIF
	ENDIF

	IFNB RGB
		LD BC,RGB << 8 + RGC
	ELSE
		LD C,RGC
	ENDIF
		RST 0x10
		ENDM
